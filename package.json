{
  "name": "ibss-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "schema:validate": "sanity schemas validate",
    "typegen": "sanity schemas extract --path schema.json --force && sanity typegen generate",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "sanity": "node --env-file-if-exists=.env.local node_modules/@sanity/cli/bin/run.js",
    "scan:build": "tsx --env-file-if-exists=.env.local scripts/scan-build.ts",
    "verify:content": "tsx --env-file-if-exists=.env.local scripts/verify-sanity.ts content",
    "verify:privacy": "tsx --env-file-if-exists=.env.local scripts/verify-sanity.ts privacy"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@sanity/image-url": "2.1",
    "@sanity/vision": "^6.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "next-sanity": "13.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^19.3.1",
    "sanity": "6.20",
    "server-only": "^0.0.1",
    "styled-components": "^6.6.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sanity/client": "^8.11.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^29.1.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
