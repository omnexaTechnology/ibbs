# Copy to .env.local (never commit real values). Setup steps: docs/SANITY-SETUP.md
# The site builds and runs WITHOUT any of these (it then shows its built-in defaults).

# --- Sanity (FEAT-002) ---
# Public config (safe in the browser). The Studio and the site read these.
NEXT_PUBLIC_SANITY_PROJECT_ID=zf4tpgl3
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only. Role "Viewer" in sanity.io/manage > API > Tokens. Used by the site to read published content
# (needed once the dataset is private). Never prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# Server-only. Role "Editor". Used by the seed script (npm run seed) and, in FEAT-004, to create lead documents.
SANITY_API_WRITE_TOKEN=

# Shared secret between the Sanity webhook and POST /api/revalidate (any long random string).
SANITY_REVALIDATE_SECRET=

# Public site origin used for canonical and hreflang URLs (metadataBase), e.g. https://www.example.com
NEXT_PUBLIC_SITE_URL=

# --- FEAT-004 (not used yet) ---
# RESEND_API_KEY=
# LEAD_FALLBACK_EMAIL=
