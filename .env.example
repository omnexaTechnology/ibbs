# Copy to .env.local (never commit real values). Setup steps: docs/SANITY-SETUP.md
# The site builds and runs WITHOUT any of these (it then shows its built-in defaults).

# --- Sanity (FEAT-002) ---
# Public config (safe in the browser). The Studio and the site read these.
NEXT_PUBLIC_SANITY_PROJECT_ID=zf4tpgl3
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only. Role "Viewer" in sanity.io/manage > API > Tokens. Used by the site to read published content
# (needed once the dataset is private). Never prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# Server-only. Role "Editor". Used by the seed script (npm run seed) and by POST /api/leads to create lead documents.
SANITY_API_WRITE_TOKEN=

# Shared secret between the Sanity webhook and POST /api/revalidate (any long random string).
SANITY_REVALIDATE_SECRET=

# Public site origin used for canonical and hreflang URLs (metadataBase), e.g. https://www.example.com
NEXT_PUBLIC_SITE_URL=

# --- FEAT-004 lead forms (POST /api/leads). All server-only; never prefix with NEXT_PUBLIC_. ---
# Without them the form shows its error state (and the WhatsApp fallback); the site still builds.
# API key from resend.com (sending access).
RESEND_API_KEY=
# Sender. Empty = Resend test sender (onboarding@resend.dev), which only delivers to the Resend account
# owner. After the client domain is verified: IBSS Website <leads@their-domain.com>
LEAD_FROM_EMAIL=
# Used when the Studio Lead routing has no recipients. While Resend is in test mode it must be the Resend
# account owner address. Example (set the real value in Vercel, not here):
# LEAD_FALLBACK_EMAIL=melamrosy72@gmail.com
LEAD_FALLBACK_EMAIL=
# Leads are created with SANITY_API_WRITE_TOKEN (above): add it to Vercel (Production only) when FEAT-004 ships.
